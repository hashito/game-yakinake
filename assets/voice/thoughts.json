{
 "t1": {
  "text": "全部は入らなかった。残りは、そこに置いてある。",
  "file": "t-en42d0.mp3",
  "sec": 3.9
 },
 "t2": {
  "text": "そこには入らない。回すか、ほかの物を動かす。",
  "file": "t-167p0b6.mp3",
  "sec": 4
 },
 "t3": {
  "text": "保管箱の中の物は構えられない。",
  "file": "t-em9mnt.mp3",
  "sec": 2.5
 },
 "t4": {
  "text": "ここでは回せない。持ち上げてから回す。",
  "file": "t-fgy747.mp3",
  "sec": 3.1
 },
 "t5": {
  "text": "入る場所がない。",
  "file": "t-d5sf91.mp3",
  "sec": 1.2
 },
 "t6": {
  "text": "今は、手当ての必要はない。",
  "file": "t-abvenu.mp3",
  "sec": 2.3
 },
 "t7": {
  "text": "手当てに使える物がない。包帯や救急箱を探す。",
  "file": "t-70xes3.mp3",
  "sec": 4
 },
 "t8": {
  "text": "構える物がない。",
  "file": "t-3q8v5q.mp3",
  "sec": 1.4
 },
 "t9": {
  "text": "振りほどいた。",
  "file": "t-cb3h4n.mp3",
  "sec": 1
 },
 "t10": {
  "text": "写真の奥、ロッカーの前に、誰か立っている。……写っている札は、二十三番。",
  "file": "t-5w9ken.mp3",
  "sec": 6.5
 }
}
